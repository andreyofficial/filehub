# JWT signing secret (any long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Port for the app
PORT=3000

# Where PayPal redirects after approval (must match how you open the site)
PUBLIC_BASE_URL=http://localhost:3000

# PayPal REST API (Dashboard → Apps & credentials → Sandbox app)
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use sandbox (true) unless you switch to live keys
PAYPAL_SANDBOX=true

# Your Gmail (lowercase). This account may DELETE any listing (moderation).
# Everyone else may only delete their own listings.
ADMIN_EMAIL=you@gmail.com
